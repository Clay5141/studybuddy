# StudyBuddy environment configuration — copy to .env or export directly.

# mock = offline demo with deterministic replies (no AWS account needed)
# live = real Strands agents on Amazon Bedrock
STUDYBUDDY_MODE=mock

# Live mode only: Bedrock model + region (defaults shown).
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
AWS_REGION=us-east-1

# Standard AWS credentials for live mode (or use an IAM role / aws configure):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: where per-student progress JSON files are stored.
# STUDYBUDDY_DATA_DIR=/path/to/progress
